{
  "name": "attendance-desk-server",
  "private": true,
  "version": "0.1.0",
  "description": "Server for Attendance Desk: reads punch files and HR emails, applies the rules, sends reminders and monthly reports.",
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "start": "node dist/app.cjs",
    "cron": "node dist/cron.cjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node build.mjs",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "cfb": "^1.2.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "jszip": "^3.10.1",
    "knex": "^3.1.0",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.12",
    "better-sqlite3": "^12.4.1",
    "esbuild": "^0.25.11",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
